          class="transition-colors hover:text-foreground text-black"
          data-slot="breadcrumb-link"
        >
          Buscador de héroes
        </a>
      </li>
    </ol>
  </nav>
  Loading....
  <div
    data-testid="search-controls"
  />
  <div
    data-testid="hero-grid"
  />
</div>
